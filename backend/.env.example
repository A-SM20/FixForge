# FixForge Backend Environment Variables
# Copy to .env and fill in real values

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixforge
OPENAI_API_KEY=sk-your-key-here
GITHUB_TOKEN=ghp_your-token-here

# Agent settings
MAX_ITERATIONS=5

# Sandbox settings
SANDBOX_MEM_LIMIT=1g
SANDBOX_CPU_LIMIT=1000000000
SANDBOX_TIMEOUT=300
