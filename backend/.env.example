# FixForge Backend Environment Variables

# Database (Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fixforge

# GitHub PAT (for reading issues & opening PRs)
GITHUB_TOKEN=ghp_your-token-here

# -------------------------------------------------------------
# Option A: Free Google Gemini API Key (Recommended Free Tier)
# 1. Get your free key at: https://aistudio.google.com/app/apikey
# 2. Set these three lines:
OPENAI_API_KEY=AIzaSy_your_gemini_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# Option B: OpenAI API Key (Pay-as-you-go)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# Agent settings
MAX_ITERATIONS=5

# Sandbox settings
SANDBOX_MEM_LIMIT=1g
SANDBOX_CPU_LIMIT=1000000000
SANDBOX_TIMEOUT=300
